#!/bin/bash

# omakub:summary=Ensure the Omakasui keyring packages, which provide the APT signing keys and sources, are installed for this Ubuntu release.
# omakub:requires-sudo=true

set -euo pipefail

echo -e "\e[32m\nUpdate Omakasui signing keys\e[0m"

codename=$(. /etc/os-release && echo "${UBUNTU_CODENAME:-${VERSION_CODENAME:-}}")
if [[ -z $codename ]]; then
  echo "Error: unable to determine the Ubuntu codename from /etc/os-release" >&2
  exit 1
fi

state_file=/var/lib/omakasui/ubuntu-codename
if omakub-pkg-present omakasui-archive-keyring omakasui-core-archive-keyring &&
  [[ -f $state_file ]] && [[ $(<"$state_file") == "$codename" ]]; then
  echo "Keyrings are current for $codename, skipping."
  exit 0
fi

tmp_dir=$(mktemp -d)
chmod 755 "$tmp_dir"
trap 'rm -rf "$tmp_dir"' EXIT

if ! curl -fsSL -o "$tmp_dir/omakasui-archive-keyring.deb" \
    "https://packages.omakasui.org/omakasui-archive-keyring/$codename.deb" ||
  ! curl -fsSL -o "$tmp_dir/omakasui-core-archive-keyring.deb" \
    "https://core.omakasui.org/omakasui-core-archive-keyring/$codename.deb"; then
  echo "Error: failed to download Omakasui keyring packages for $codename." >&2
  exit 1
fi

sudo apt-get install -y "$tmp_dir/omakasui-archive-keyring.deb" "$tmp_dir/omakasui-core-archive-keyring.deb"
sudo install -d -m 0755 "$(dirname "$state_file")"
printf '%s\n' "$codename" | sudo tee "$state_file" >/dev/null
